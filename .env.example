# Solana RPC URL (use Helius or other premium RPC for production)
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Solana network: devnet | mainnet-beta
NEXT_PUBLIC_NETWORK=devnet

# Collection Details
NEXT_PUBLIC_COLLECTION_NAME=Paperboy NFT
NEXT_PUBLIC_COLLECTION_DESCRIPTION=A Solana NFT collection powered by Metaplex Core
NEXT_PUBLIC_COLLECTION_SUPPLY=1000

# Candy Machine address (set after running setup-candy-machine script)
NEXT_PUBLIC_CANDY_MACHINE_ID=

# Collection address (set after running create-collection script)
NEXT_PUBLIC_COLLECTION_ID=

# Mint price in SOL (0 for free mint)
NEXT_PUBLIC_MINT_PRICE=0

# Treasury wallet address (receives mint payments)
TREASURY_WALLET=

# Creator keypair path (for admin scripts only - NEVER expose publicly)
CREATOR_KEYPAIR_PATH=./creator-keypair.json
